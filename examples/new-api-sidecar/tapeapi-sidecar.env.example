# PLACEHOLDERS ONLY: the sidecar's settings for docker-compose.sidecar.yml (the sidecar added to the new-api compose you
# already run). Copy to tapeapi-sidecar.env, chmod 600, fill it in, never commit it. There is no SIGNER_KEY line: the
# key is made inside the container and kept in its volume (see docker-compose.sidecar.yml).
# 这里全是占位符：docker-compose.sidecar.yml（加进你现有 new-api compose 的旁路）用的旁路设置。复制为 tapeapi-sidecar.env，
# chmod 600，再填写；永远不要提交。这里没有 SIGNER_KEY：密钥在容器内生成并保存在它的卷里（见 docker-compose.sidecar.yml）。

# The sidecar's OWN hostname (a bare https origin), not your existing API hostname: api.example.com stays as it is.
# 旁路**自己的**主机名（只到域名的 https 地址），不是你现有的接口主机名：api.example.com 保持不变。
PUBLIC_URL=https://tape.example.com

# new-api's /v1 base inside the compose network: its service name in YOUR compose file (new-api in the official one).
# compose 网络内 new-api 的 /v1 地址：用**你的** compose 文件里它的服务名（官方文件里是 new-api）。
UPSTREAM_BASE_URL=http://new-api:3000/v1

# SET IT. The API formats your new-api REALLY serves: openai-chat, openai-responses, anthropic-messages,
# openai-embeddings (comma-separated, or all). The manifest is a public statement on chain; OpenAI-compatible channels
# only: FORMATS=openai-chat. Left empty for you to choose: empty, the sidecar publishes all four and warns, naming FORMATS.
# 请设置。你的 new-api **真正提供**的 API 格式（逗号分隔，或 all）。清单是链上的公开声明；渠道只兼容 OpenAI：FORMATS=openai-chat。
# 留空由你来选：留空时旁路发布全部四种并警告、点名 FORMATS。
FORMATS=

# Identity: the holder console shows these values. / 身份：持有人操作台会给出这些值。
CIRCUITS=0xREPLACE_WITH_CIRCUITS_ADDRESS
TOKEN_ID=REPLACE_WITH_TOKEN_ID
CONTAINER=0xREPLACE_WITH_CONTAINER_ADDRESS
DELEGATION_EXPIRES=
DELEGATION_SIG=

# After the first start, put the address the log printed (the key's address, public) here: if the key volume is ever
# lost, the sidecar then stops in setup mode and says so, instead of making a key the delegation does not name.
# 第一次启动后，把日志打印的地址（密钥的地址，公开值）填在这里：万一密钥卷丢失，旁路会停在设置模式并说明，而不是生成一把委托里没有的新密钥。
# SIGNER_ADDRESS=0xREPLACE_WITH_THE_ADDRESS_THE_LOG_PRINTED

# Optional: your own site. GET / on tape.example.com answers 302 there (no parameter is ever added).
# Unset: GET / answers 404, as before. It cannot be the TapeAPI holder console.
# 可选：你自己的站点。tape.example.com 上的 GET / 302 跳转过去（从不附加任何参数）。未设：GET / 与以前一样回答 404。
# 不能填 TapeAPI 的持有人操作台。
# OPERATOR_SITE_URL=https://www.example.com

# Optional / 可选
# TAPE_NAME=42.1013.tape      (an example name: put yours / 示例名：换成你的)
# SERVICE_NAME=My AI relay
# CLIENT_IP_HEADER=x-real-ip
# RATE_IP=600
