# PLACEHOLDERS ONLY. Copy this file to .env (`cp env.example .env`), fill it in, and never commit .env.
# 这里全是占位符。复制为 .env（`cp env.example .env`）再填写；.env 永远不要提交。
# (This file is named env.example, without the leading dot, so that it is published with the example; .env files never are.)
# （本文件名不带前导点，是为了能随示例公开；以点开头的 .env 文件一律不公开。）

# ---- new-api ----
# A long random secret for new-api's logins; generate one with: openssl rand -hex 32   (new-api refuses "random_string")
# new-api 登录用的随机密钥：openssl rand -hex 32 生成（new-api 拒绝 "random_string"）
# Left empty on purpose: `docker compose up` refuses to start until you set it. / 刻意留空：不设置它 docker compose 就拒绝启动。
SESSION_SECRET=
TZ=Asia/Shanghai

# ---- the TapeAPI sidecar / 签名旁路 ----
# The public https root of the SIDECAR (your users' base URL root), terminated by your reverse proxy. A bare origin: no path.
# 旁路的公网 https 根地址（用户的 base URL 根），TLS 由你的反向代理终结。只写到域名，不带路径。
PUBLIC_URL=https://api.example.com

# Identity: the holder console (https://tapeapi.fun/console/) shows these values in steps 2 to 4.
# 身份：持有人操作台（https://tapeapi.fun/console/）第 2 到 4 步会给出这些值。
CIRCUITS=0xREPLACE_WITH_CIRCUITS_ADDRESS
TOKEN_ID=REPLACE_WITH_TOKEN_ID
CONTAINER=0xREPLACE_WITH_CONTAINER_ADDRESS
DELEGATION_EXPIRES=
DELEGATION_SIG=

# SECRET. The service key from step 3 of the holder console. Keep it out of git, chat, screenshots and tickets.
# 机密。持有人操作台第 3 步生成的服务密钥。不要进 git、聊天、截图或工单。
SIGNER_KEY=

# Optional / 可选
# TAPE_NAME=42.1013.tape
# SERVICE_NAME=My AI relay
# RATE_IP=600
# CLIENT_IP_HEADER=x-real-ip
# How long receipts stay retrievable by the free `receipt` method (seconds, default 3600). / 回执可取回的秒数（默认 3600）。
# RECEIPT_TTL_S=3600
# 1: a receipt lookup must name requestSha256 too. Set it when a channel's answer ids are guessable (Ollama's are
# "chatcmpl-" and a number below 999); the sidecar's log says when it sees such ids.
# 1：取回执须同时给出 requestSha256。渠道的回答 id 可猜时设置（Ollama 的是 "chatcmpl-" 加一个小于 999 的数）；旁路看到这种 id 会在日志里提示。
# RECEIPT_REQUIRE_HASH=1
# 0: do not pass the clients' session headers (x-claude-code-session-id, session-id, thread-id) to new-api; they tie a
# user's requests into one session. Default 1 (passed, as the clients expect).
# 0：不把客户端的会话头转发给 new-api（它们会把同一用户的请求串成一段会话）。默认 1（转发，客户端期望如此）。
# FORWARD_SESSION_HEADERS=0

# Where the sidecar listens on the host: loopback by default, for your reverse proxy. / 旁路在宿主机上的监听地址：默认只在回环地址，给反向代理用。
SIDECAR_BIND=127.0.0.1
SIDECAR_PORT=8080
