# PLACEHOLDERS ONLY. Copy this file to .env (`cp env.example .env && chmod 600 .env`), fill it in, and never commit .env.
# 这里全是占位符。复制为 .env（`cp env.example .env && chmod 600 .env`）再填写；.env 永远不要提交。
# (This file is named env.example, without the leading dot, so that it is published with the example; .env files never are.)
# （本文件名不带前导点，是为了能随示例公开；以点开头的 .env 文件一律不公开。）

# ---- LiteLLM ----
# Left empty on purpose: `docker compose up` refuses to start until you set them. / 刻意留空：不设置 docker compose 就拒绝启动。
# The admin key; LiteLLM wants it to start with sk-:  echo "sk-$(openssl rand -hex 24)"
# 管理员密钥，LiteLLM 要求以 sk- 开头：echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=
# Encrypts stored provider credentials; set once, never change:  openssl rand -hex 32
# 加密存储的服务商凭据；只设一次，之后不要改：openssl rand -hex 32
LITELLM_SALT_KEY=
# LiteLLM's PostgreSQL (virtual keys, budgets, spend):  openssl rand -hex 16
# LiteLLM 的 PostgreSQL（虚拟密钥、预算、花费）：openssl rand -hex 16
POSTGRES_PASSWORD=
# Provider keys, as config.yaml references them (os.environ/...). / 服务商密钥，按 config.yaml 的引用填写。
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ---- the TapeAPI sidecar / 签名旁路 ----
# The public https root of the SIDECAR (your users' base URL root), terminated by your reverse proxy. A bare origin: no path.
# 旁路的公网 https 根地址（用户的 base URL 根），TLS 由你的反向代理终结。只写到域名，不带路径。
PUBLIC_URL=https://api.example.com

# Identity: the holder console (https://tapeapi.fun/console/) shows these values in steps 2 to 4.
# 身份：持有人操作台（https://tapeapi.fun/console/）第 2 到 4 步会给出这些值。
CIRCUITS=0xREPLACE_WITH_CIRCUITS_ADDRESS
TOKEN_ID=REPLACE_WITH_TOKEN_ID
CONTAINER=0xREPLACE_WITH_CONTAINER_ADDRESS
DELEGATION_EXPIRES=
DELEGATION_SIG=

# SECRET. The service key from step 3 of the holder console. Keep it out of git, chat, screenshots and tickets.
# 机密。持有人操作台第 3 步生成的服务密钥。不要进 git、聊天、截图或工单。
SIGNER_KEY=

# Optional / 可选
# TAPE_NAME=42.1013.tape      (an example name: put yours / 示例名：换成你的)
# SERVICE_NAME=My AI gateway
# RATE_IP=600
# CLIENT_IP_HEADER=x-real-ip
# How long receipts stay retrievable by the free `receipt` method (seconds, default 3600). / 回执可取回的秒数（默认 3600）。
# RECEIPT_TTL_S=3600
# 1: a receipt lookup must name requestSha256 too (set it when the sidecar's log says answer ids look guessable).
# 1：取回执须同时给出 requestSha256（旁路日志提示回答 id 可猜时设置）。
# RECEIPT_REQUIRE_HASH=1
# 0: do not pass the clients' session headers (x-claude-code-session-id, session-id, thread-id) to LiteLLM.
# 0：不把客户端的会话头转发给 LiteLLM。
# FORWARD_SESSION_HEADERS=0

# Where the sidecar and LiteLLM listen on the host: loopback by default. / 旁路与 LiteLLM 在宿主机上的监听：默认只在回环地址。
SIDECAR_BIND=127.0.0.1
SIDECAR_PORT=8080
LITELLM_PORT=4000
