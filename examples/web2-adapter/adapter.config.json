{
  "upstream": {
    "timeoutMs": 8000,
    "headers": { "accept": "application/json", "x-api-key": "${UPSTREAM_API_KEY}" }
  },
  "methods": {
    "fxRate": {
      "priceBEM": "0",
      "url": "https://api.frankfurter.dev/v1/latest",
      "method": "GET",
      "params": { "from": "string", "to": "string" },
      "defaults": { "from": "USD", "to": "EUR" },
      "query": { "from": "from", "to": "to" },
      "pick": { "base": "base", "date": "date", "rates": "rates" },
      "returns": { "base": "string", "date": "string", "rates": "object" }
    },
    "fxConvert": {
      "priceBEM": "0.0001",
      "url": "https://api.frankfurter.dev/v1/latest",
      "method": "GET",
      "params": { "amount": "number", "from": "string", "to": "string" },
      "required": ["amount"],
      "defaults": { "from": "USD", "to": "EUR" },
      "query": { "amount": "amount", "from": "from", "to": "to" },
      "pick": { "amount": "amount", "base": "base", "date": "date", "rates": "rates" },
      "returns": { "amount": "number", "base": "string", "date": "string", "rates": "object" }
    },
    "spotPrice": {
      "priceBEM": "0",
      "url": "https://api.coinbase.com/v2/prices/{pair}/spot",
      "method": "GET",
      "params": { "pair": "string" },
      "required": ["pair"],
      "pick": { "amount": "data.amount", "base": "data.base", "currency": "data.currency" },
      "returns": { "amount": "string", "base": "string", "currency": "string" }
    },
    "cryptoRates": {
      "priceBEM": "0",
      "url": "https://api.coinbase.com/v2/exchange-rates",
      "method": "GET",
      "params": { "currency": "string" },
      "defaults": { "currency": "BNB" },
      "query": { "currency": "currency" },
      "pick": { "currency": "data.currency", "usd": "data.rates.USD", "eur": "data.rates.EUR" },
      "returns": { "currency": "string", "usd": "string", "eur": "string" }
    }
  }
}
