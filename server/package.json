{
  "name": "@tapeapi/server",
  "version": "0.7.0",
  "description": "TapeAPI provider runtime: serve signed, optionally paid methods from Node or any fetch runtime (TapeOut protocol on BNB Smart Chain)",
  "keywords": [
    "tapeapi",
    "tapeout",
    "bnb",
    "bsc",
    "web3",
    "api",
    "provider",
    "signed-response",
    "micropayments",
    "cloudflare-workers"
  ],
  "homepage": "https://tapeapi.fun/docs/",
  "bugs": {
    "url": "https://github.com/BruceLanLan/tapeapi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BruceLanLan/tapeapi.git",
    "directory": "server"
  },
  "license": "MIT",
  "author": "Bruce (@BruceLanLan)",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./mcp": {
      "types": "./types/mcp.d.ts",
      "default": "./src/mcp.js"
    },
    "./mcp-proxy": {
      "types": "./types/mcp-proxy.d.ts",
      "default": "./src/mcp-proxy.js"
    },
    "./ai-proxy": {
      "types": "./types/ai-proxy.d.ts",
      "default": "./src/ai-proxy.js"
    },
    "./openai-proxy": {
      "types": "./types/openai-proxy.d.ts",
      "default": "./src/openai-proxy.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test"
  },
  "dependencies": {
    "@tapeapi/sdk": "^0.7.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
