{
  "name": "@tapeapi/sdk",
  "version": "1.1.0",
  "description": "TapeAPI JavaScript SDK: resolve on-chain services, call them and verify every signed answer (TapeOut protocol on BNB Smart Chain)",
  "keywords": [
    "tapeapi",
    "tapeout",
    "bnb",
    "bsc",
    "web3",
    "api",
    "signed-response",
    "micropayments",
    "webmcp",
    "mcp"
  ],
  "homepage": "https://tapeapi.fun/docs/",
  "bugs": {
    "url": "https://github.com/BruceLanLan/tapeapi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BruceLanLan/tapeapi.git",
    "directory": "sdk"
  },
  "license": "MIT",
  "author": "Bruce (@BruceLanLan)",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "bin": {
    "tapeapi-mcp": "./bin/tapeapi-mcp.js",
    "tapeapi-verify": "./bin/tapeapi-verify.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./rpc": {
      "types": "./types/rpc.d.ts",
      "default": "./src/rpc-public.js"
    },
    "./chains": {
      "types": "./types/chains.d.ts",
      "default": "./src/chains.js"
    },
    "./abi": {
      "types": "./types/abi.d.ts",
      "default": "./src/abi.js"
    },
    "./canon": {
      "types": "./types/canon.d.ts",
      "default": "./src/canon.js"
    },
    "./sig": {
      "types": "./types/sig.d.ts",
      "default": "./src/sig.js"
    },
    "./channel": {
      "types": "./types/channel.d.ts",
      "default": "./src/channel-public.js"
    },
    "./bus-privacy": {
      "types": "./types/bus-privacy.d.ts",
      "default": "./src/bus-privacy.js"
    },
    "./manifest": {
      "types": "./types/manifest.d.ts",
      "default": "./src/manifest.js"
    },
    "./webmcp": {
      "types": "./types/webmcp.d.ts",
      "default": "./src/webmcp.js"
    },
    "./mcp": {
      "types": "./types/mcp.d.ts",
      "default": "./src/mcp.js"
    },
    "./ai": {
      "types": "./types/ai.d.ts",
      "default": "./src/ai-public.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "types",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test"
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
