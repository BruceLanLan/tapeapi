pragma solidity ^0.8.24;

// Container agents, phase 1, milestone M3 (experimental, internal design notes, phase 1, §2.5,
// §2.6, §6.2 M3): the very transactions the SDK's escrowPlan and closeOutPlan build (Phase1PlanFixture.sol, generated by
// scripts/gen-phase1-plan-fixture.mjs and checked by sdk/test/agent-phase1-plan.test.mjs) executed as the holder sends
// them, on the UNCHANGED v3 escrow at the vectors' addresses, then read back: each channel equals its cap, the agent
// key's session equals the mandate's expires, the allowance is 0. Both funding paths: F2 from the holder's wallet, F1
// through a container stand-in whose execute takes the TapeOut fee (a short one reverts 0xafd49700(paid, required), as
// read on BNB Smart Chain) and can be gated. A test-local deployment only: nothing is broadcast.
// 阶段 1 的 M3：在未改的 v3 托管上按持有人发送的样子执行 SDK 计划构造的交易，再读回：通道等于 cap、会话等于 expires、额度为 0。
// F2 与 F1 两条路径；F1 用收 TapeOut 费、可设门槛的容器替身。只是测试内部署，不广播。
import "forge-std/Test.sol";
import {TapeAPIEscrow} from "../src/TapeAPIEscrow.sol";
import {CooldownActive} from "../src/interfaces.sol";
import {Mal_ERC20, Mal_Hub} from "./mocks/MaliciousTokens.sol";
import {Phase1PlanFixture as F} from "./Phase1PlanFixture.sol";

/// @dev An ERC-6551 container's execute as the plan relies on it: owner only, the TapeOut fee in the native coin (a
///      short payment reverts 0xafd49700(paid, required), the excess refunded), a gate (payment, listing) that stops it,
///      then the inner call. A stand-in, not TapeOut's implementation. / 容器 execute 的替身，不是 TapeOut 的实现
contract Phase1PlanContainer {
    address public immutable owner;
    uint256 public immutable fee;
    address public immutable treasury;
    bool public gated;
    error NotOwner();
    constructor(address owner_, uint256 fee_, address treasury_) { owner = owner_; fee = fee_; treasury = treasury_; }
    function setGated(bool g) external { gated = g; }
    function execute(address to, uint256 value, bytes calldata data, uint8 operation) external payable returns (bytes memory) {
        if (msg.sender != owner) revert NotOwner();
        if (msg.value < fee) {
            bytes memory e = abi.encodeWithSelector(bytes4(0xafd49700), msg.value, fee);
            assembly { revert(add(e, 32), mload(e)) }
        }
        require(!gated, "gated");
        require(operation == 0, "call only");
        (bool okT,) = treasury.call{value: fee}("");
        require(okT, "treasury");
        if (msg.value > fee) { (bool okR,) = msg.sender.call{value: msg.value - fee}(""); require(okR, "refund"); }
        (bool ok, bytes memory ret) = to.call{value: value}(data);
        if (!ok) assembly { revert(add(ret, 32), mload(ret)) }
        return ret;
    }
}

/// @dev An 8- or 18-decimal ERC-20 to deploy at the vectors' token addresses / 部署到向量代币地址的 ERC-20
contract Phase1PlanToken is Mal_ERC20 {
    uint8 public immutable decimals;
    constructor(uint8 d) { decimals = d; }
}

contract Phase1PlanTest is Test {
    TapeAPIEscrow e1;
    TapeAPIEscrow e2;
    TapeAPIEscrow e3;   // review p1m3 recheck: the escrow the provider moved to (TOKEN1) / provider 搬去的托管
    Phase1PlanToken t1;
    Phase1PlanToken t2;
    Phase1PlanContainer box;
    address treasury = address(0x70);
    address tapeOut = address(0x7E);

    function setUp() public {
        vm.warp(F.NOT_BEFORE);   // the holder sends the plan at notBefore (draft R17) / 在 notBefore 发出计划
        deployCodeTo("Phase1Plan.t.sol:Phase1PlanToken", abi.encode(uint8(8)), F.TOKEN1);
        deployCodeTo("Phase1Plan.t.sol:Phase1PlanToken", abi.encode(uint8(18)), F.TOKEN2);
        address hub = address(new Mal_Hub());
        deployCodeTo("TapeAPIEscrow.sol:TapeAPIEscrow", abi.encode(F.TOKEN1, hub, treasury), F.E1);
        deployCodeTo("TapeAPIEscrow.sol:TapeAPIEscrow", abi.encode(F.TOKEN2, hub, treasury), F.E2);
        deployCodeTo("TapeAPIEscrow.sol:TapeAPIEscrow", abi.encode(F.TOKEN1, hub, treasury), F.E3);
        e3 = TapeAPIEscrow(F.E3);
        deployCodeTo("Phase1Plan.t.sol:Phase1PlanContainer", abi.encode(F.HOLDER, F.EXECUTE_FEE, tapeOut), F.PRINCIPAL);
        e1 = TapeAPIEscrow(F.E1); e2 = TapeAPIEscrow(F.E2);
        t1 = Phase1PlanToken(F.TOKEN1); t2 = Phase1PlanToken(F.TOKEN2);
        box = Phase1PlanContainer(payable(F.PRINCIPAL));
        vm.deal(F.HOLDER, 1 ether);
    }

    function _send(F.Tx memory t) internal {
        vm.prank(F.HOLDER);
        (bool ok, bytes memory r) = t.to.call{value: t.value}(t.data);
        if (!ok) assembly { revert(add(r, 32), mload(r)) }
    }
    function _sendAll(F.Tx[] memory ts) internal { for (uint256 i = 0; i < ts.length; i++) _send(ts[i]); }
    // the channel (holder, P2) already holds 20 before the plan (vector: "one channel partly funded")
    function _prefundP2() internal {
        t1.mint(F.HOLDER, 20);
        vm.startPrank(F.HOLDER);
        t1.approve(F.E1, 20);
        e1.fund(F.P2, 20);
        vm.stopPrank();
    }

    /// F2: one exact approve of 130, fund 100 and 30, a session on each channel; read back as the mandate says.
    function test_holderPlan_twoProviders_readsBackAsTheMandate() public {
        _prefundP2();
        t1.mint(F.HOLDER, 130);
        _sendAll(F.holderTwoProviders());
        assertEq(e1.channelOf(F.HOLDER, F.P1), 100);
        assertEq(e1.channelOf(F.HOLDER, F.P2), 50);
        assertEq(e1.sessionExpiry(F.HOLDER, F.P1, F.AGENT_KEY), F.EXPIRES);
        assertEq(e1.sessionExpiry(F.HOLDER, F.P2, F.AGENT_KEY), F.EXPIRES);
        assertEq(t1.allowance(F.HOLDER, F.E1), 0);
        assertEq(t1.balanceOf(F.HOLDER), 0);
        // the principal's own channels are untouched (F2 funds the holder's) / F2 不碰委托方容器的通道
        assertEq(e1.channelOf(F.PRINCIPAL, F.P1), 0);
        // the same authorizeSession again (a second run) is harmless: equal is not shortening / 重发同一会话无害
        F.Tx[] memory ts = F.holderTwoProviders();
        _send(ts[3]);
        assertEq(e1.sessionExpiry(F.HOLDER, F.P1, F.AGENT_KEY), F.EXPIRES);
    }

    /// F2 with two escrows (one token each): two approves, each spent exactly.
    function test_holderPlan_twoEscrows_readsBackAsTheMandate() public {
        t1.mint(F.HOLDER, 100);
        t2.mint(F.HOLDER, 50);
        _sendAll(F.holderTwoEscrows());
        assertEq(e1.channelOf(F.HOLDER, F.P1), 100);
        assertEq(e2.channelOf(F.HOLDER, F.P2), 50);
        assertEq(e1.sessionExpiry(F.HOLDER, F.P1, F.AGENT_KEY), F.EXPIRES);
        assertEq(e2.sessionExpiry(F.HOLDER, F.P2, F.AGENT_KEY), F.EXPIRES);
        assertEq(e1.sessionExpiry(F.HOLDER, F.P2, F.AGENT_KEY), 0);   // one channel per (consumer, provider, escrow)
        assertEq(t1.allowance(F.HOLDER, F.E1), 0);
        assertEq(t2.allowance(F.HOLDER, F.E2), 0);
    }

    /// A fund that fails midway leaves the allowance; the plan's approve(escrow, 0) clears it (draft §2.1, §2.5 step 4).
    function test_failedFund_leavesTheAllowance_theApproveZeroClearsIt() public {
        _prefundP2();
        t1.mint(F.HOLDER, 100);   // 30 short of the plan / 比计划少 30
        F.Tx[] memory ts = F.holderTwoProviders();
        _send(ts[0]);
        _send(ts[1]);
        vm.expectRevert();
        this.sendExternal(ts[2]);
        assertEq(t1.allowance(F.HOLDER, F.E1), 30);   // what the SDK's afterPlan reads as allowance-not-zero
        assertEq(e1.channelOf(F.HOLDER, F.P2), 20);   // ... and channel-not-at-cap
        _send(F.holderTwoProvidersApproveZero());
        assertEq(t1.allowance(F.HOLDER, F.E1), 0);
    }
    function sendExternal(F.Tx memory t) external { _send(t); }
    function callAs(address from, F.Tx memory t) external {
        vm.deal(from, from.balance + t.value);
        vm.prank(from);
        (bool ok, bytes memory r) = t.to.call{value: t.value}(t.data);
        if (!ok) assembly { revert(add(r, 32), mload(r)) }
    }

    /// F1: the fee the SDK finds by simulation (a revert 0xafd49700(0, fee)), then each execute with it; read back.
    function test_containerPlan_feeFoundBySimulation_readsBackAsTheMandate() public {
        t1.mint(F.PRINCIPAL, 1e8);
        F.Tx[] memory ts = F.containerOne();
        // what the SDK's simulation sees with value 0 / SDK 用 value 0 模拟时看到的回滚
        vm.expectRevert(abi.encodeWithSelector(bytes4(0xafd49700), uint256(0), F.EXECUTE_FEE));
        this.callAs(F.HOLDER, F.Tx(F.PRINCIPAL, 0, ts[0].data));
        // one wei short of the fee is refused too / 少一 wei 也被拒
        vm.expectRevert(abi.encodeWithSelector(bytes4(0xafd49700), F.EXECUTE_FEE - 1, F.EXECUTE_FEE));
        this.callAs(F.HOLDER, F.Tx(F.PRINCIPAL, F.EXECUTE_FEE - 1, ts[0].data));
        // anyone but the holder is refused / 非持有人被拒
        vm.expectRevert(Phase1PlanContainer.NotOwner.selector);
        this.callAs(address(0xBAD), ts[0]);
        uint256 before = F.HOLDER.balance;
        _sendAll(ts);
        assertEq(e1.channelOf(F.PRINCIPAL, F.P1), 1e8);
        assertEq(e1.sessionExpiry(F.PRINCIPAL, F.P1, F.AGENT_KEY), F.EXPIRES);
        assertEq(t1.allowance(F.PRINCIPAL, F.E1), 0);
        assertEq(tapeOut.balance, 3 * F.EXECUTE_FEE);                   // the fee goes to TapeOut, never to the escrow
        assertEq(before - F.HOLDER.balance, 3 * F.EXECUTE_FEE);
        assertEq(e1.channelOf(F.HOLDER, F.P1), 0);                       // F1 funds the principal's channel only
    }

    /// F1: a gate (payment, listing) stops execute even with the fee: what the SDK reports as execute-reverts (R20).
    function test_containerGate_stopsTheFundedChannelsCloseOut() public {
        t1.mint(F.PRINCIPAL, 1e8);
        _sendAll(F.containerOne());
        box.setGated(true);
        vm.warp(F.CLOSE_AT);
        F.Tx[] memory c = F.containerOneCloseOut();
        vm.expectRevert(bytes("gated"));
        this.sendExternal(c[0]);
        // the money stays exposed to the key until the gate opens (R20) / 门槛打开前钱一直暴露给钥匙
        assertEq(e1.channelOf(F.PRINCIPAL, F.P1), 1e8);
    }

    /// The close-out (F2): requestWithdraw of whole channels, withdraw refused before 48 h, then executed: all back.
    function test_holderCloseOut_withdrawsEveryChannelAfterTheCooldown() public {
        _prefundP2();
        t1.mint(F.HOLDER, 130);
        _sendAll(F.holderTwoProviders());
        vm.warp(F.CLOSE_AT);
        F.Tx[] memory c = F.holderTwoProvidersCloseOut();
        _send(c[0]);
        _send(c[1]);
        vm.expectRevert(abi.encodeWithSelector(CooldownActive.selector, uint64(F.CLOSE_AT + 48 hours)));
        this.sendExternal(c[2]);
        vm.warp(F.CLOSE_AT + 48 hours);
        _send(c[2]);
        _send(c[3]);
        assertEq(e1.channelOf(F.HOLDER, F.P1), 0);
        assertEq(e1.channelOf(F.HOLDER, F.P2), 0);
        assertEq(t1.balanceOf(F.HOLDER), 150);
    }

    // ---- review p1m3 B1: the plan run again after it was applied (CONFIRMED P1M3-B1 on 4d8cdf4: the re-run funded back
    //      what the key spent, 160% of the cap; FIXED: these are the SDK's re-runs with the first plan's record) ----
    // 审查 p1m3 B1：计划应用后重跑。修复前重跑把钥匙花掉的钱再充回去（cap 的 160%）；这里执行的是 SDK 带首次 record 的重跑结果。
    function _settle(uint256 cumulative) internal {
        bytes32 d = e1.voucherDigest(F.HOLDER, F.P1, cumulative, F.EXPIRES);
        (uint8 v, bytes32 r, bytes32 s) = vm.sign(F.AGENT_KEY_PK, d);
        e1.settle(F.HOLDER, F.P1, cumulative, F.EXPIRES, abi.encodePacked(r, s, v));
    }
    /// What the key can still take, settled at once: a voucher far above the cap pays what the channel holds.
    function _drain() internal { _settle(10 * F.CAP1); }

    /// After the key spent SPENT, the SDK's re-run sends nothing; the key's total stays at the cap (was 160% of it).
    function test_rerunAfterSpend_fundsNothing_theKeyNeverExceedsTheCap() public {
        assertEq(vm.addr(F.AGENT_KEY_PK), F.AGENT_KEY);
        t1.mint(F.HOLDER, 2 * F.CAP1);
        _sendAll(F.holderOne());
        _settle(F.SPENT);
        // the chain is what the fixture's re-run was made over / 链上状态正是 fixture 重跑所用的事实
        assertEq(e1.channelOf(F.HOLDER, F.P1), F.CAP1 - F.SPENT);
        assertEq(e1.claimedOf(F.HOLDER, F.P1), F.SPENT);
        assertEq(e1.sessionExpiry(F.HOLDER, F.P1, F.AGENT_KEY), F.EXPIRES);
        assertTrue(F.RERUN_WITHOUT_HISTORY_REFUSED);           // without the history: channel-spent
        F.Tx[] memory again = F.holderOneRerunAfterSpend();
        assertEq(again.length, 0);                              // with it: no approve, no fund
        _sendAll(again);
        _drain();
        assertEq(e1.claimedOf(F.HOLDER, F.P1), F.CAP1);         // never above the cap / 绝不超过 cap
        assertEq(e1.channelOf(F.HOLDER, F.P1), 0);
        assertEq(t1.balanceOf(F.HOLDER), F.CAP1);               // the second cap never left the wallet
        assertEq(t1.allowance(F.HOLDER, F.E1), 0);
    }

    /// A fund that failed after the session was sent: the re-run funds to the cap, and the key's total is the cap.
    function test_rerunAfterFailedFund_fundsToTheCap() public {
        F.Tx[] memory ts = F.holderOne();
        _send(ts[0]);
        vm.expectRevert();
        this.sendExternal(ts[1]);                                // the holder had no tokens yet
        _send(ts[2]);
        assertEq(e1.channelOf(F.HOLDER, F.P1), 0);
        assertEq(e1.claimedOf(F.HOLDER, F.P1), 0);
        t1.mint(F.HOLDER, F.CAP1);
        _sendAll(F.holderOneRerunAfterFailedFund());
        assertEq(e1.channelOf(F.HOLDER, F.P1), F.CAP1);
        assertEq(t1.allowance(F.HOLDER, F.E1), 0);
        _drain();
        assertEq(e1.claimedOf(F.HOLDER, F.P1), F.CAP1);
    }

    /// The holder funded short by hand (CAP1 - SPENT - CAP1 / 5 short), the key spent SPENT: the re-run funds only to
    /// the budget, and the key's total is exactly the cap. / 手工少充、钥匙花掉 SPENT：重跑只补到预算，钥匙合计恰为 cap
    function test_rerunAfterSpend_fundsOnlyTheBudget() public {
        F.Tx[] memory ts = F.holderOne();
        uint256 byHand = F.SPENT + F.CAP1 / 5;
        t1.mint(F.HOLDER, F.CAP1);
        vm.startPrank(F.HOLDER);
        t1.approve(F.E1, byHand);
        e1.fund(F.P1, byHand);
        vm.stopPrank();
        _send(ts[2]);
        _settle(F.SPENT);
        assertEq(e1.channelOf(F.HOLDER, F.P1), F.CAP1 / 5);
        assertEq(e1.claimedOf(F.HOLDER, F.P1), F.SPENT);
        _sendAll(F.holderOneRerunPartial());
        assertEq(e1.channelOf(F.HOLDER, F.P1), F.CAP1 - F.SPENT);
        assertEq(t1.allowance(F.HOLDER, F.E1), 0);
        _drain();
        assertEq(e1.claimedOf(F.HOLDER, F.P1), F.CAP1);
    }

    // ---- review p1m3 recheck CE-3 / CE-4: the cap holds per (mandate, provider) over every channel the history records
    //      (CONFIRMED on e5da5b7: the re-run with the first record funded a whole second cap on the provider's new escrow,
    //      2 x the cap to P1; FIXED: funded-elsewhere, and once the old channel is withdrawn the new one gets the rest) ----
    // 复核 CE-3、CE-4：cap 按（授权书, provider）对历史记录的全部通道成立。修复前带首次 record 重跑会在新托管上再充一整个 cap（2 倍）。
    function _settleOn(TapeAPIEscrow e, address consumer, uint256 cumulative) internal {
        bytes32 d = e.voucherDigest(consumer, F.P1, cumulative, F.EXPIRES_LONG);
        (uint8 v, bytes32 r, bytes32 s) = vm.sign(F.AGENT_KEY_PK, d);
        e.settle(consumer, F.P1, cumulative, F.EXPIRES_LONG, abi.encodePacked(r, s, v));
    }
    function settleOnExternal(TapeAPIEscrow e, address consumer, uint256 cumulative) external { _settleOn(e, consumer, cumulative); }

    /// The provider moved to E3 while E1 still holds CAP1 - SPENT: the SDK refuses the re-run; the key never exceeds the cap.
    function test_escrowMoved_rerunRefused_theKeyNeverExceedsTheCap() public {
        t1.mint(F.HOLDER, 2 * F.CAP1);
        _sendAll(F.holderLongOne());
        _settleOn(e1, F.HOLDER, F.SPENT);
        assertEq(e1.channelOf(F.HOLDER, F.P1), F.CAP1 - F.SPENT);
        assertTrue(F.MOVED_RERUN_REFUSED);                       // funded-elsewhere: no transaction for E3 / 不出 E3 的交易
        _settleOn(e1, F.HOLDER, 10 * F.CAP1);                   // the key takes what is left on E1
        vm.expectRevert();                                       // nothing on E3, no session there / E3 上没钱也没会话
        this.settleOnExternal(e3, F.HOLDER, 10 * F.CAP1);
        assertEq(e1.claimedOf(F.HOLDER, F.P1) + e3.claimedOf(F.HOLDER, F.P1), F.CAP1);   // was 2 x CAP1
        assertEq(t1.balanceOf(F.HOLDER), F.CAP1);
    }

    /// The honest migration: E1 withdrawn to 0 (the SDK's close-out with the record's escrow), then the SDK's re-run funds
    /// E3 with CAP1 - SPENT only; the key, draining both, takes exactly the cap. / 诚实迁移：E1 取回到 0 后 E3 只充 CAP1 − SPENT
    function test_escrowMoved_afterTheOldChannelIsWithdrawn_theNewOneGetsOnlyTheRest() public {
        t1.mint(F.HOLDER, F.CAP1);
        _sendAll(F.holderLongOne());
        _settleOn(e1, F.HOLDER, F.SPENT);
        F.Tx[] memory c = F.holderLongCloseOutE1();
        _send(c[0]);                                             // requestWithdraw(P1, CAP1 - SPENT) on E1
        vm.warp(block.timestamp + 48 hours);
        _send(c[1]);                                             // withdraw
        assertEq(e1.channelOf(F.HOLDER, F.P1), 0);
        assertEq(e1.claimedOf(F.HOLDER, F.P1), F.SPENT);         // the fact the re-run was made over / 重跑所用的事实
        (uint256 amt, uint64 at) = e1.pendingWithdraw(F.HOLDER, F.P1);
        assertEq(amt, 0); assertEq(at, 0);
        _sendAll(F.holderLongMovedToE3());
        assertEq(e3.channelOf(F.HOLDER, F.P1), F.CAP1 - F.SPENT);
        assertEq(e3.sessionExpiry(F.HOLDER, F.P1, F.AGENT_KEY), F.EXPIRES_LONG);
        assertEq(t1.allowance(F.HOLDER, F.E3), 0);
        _settleOn(e3, F.HOLDER, 10 * F.CAP1);
        vm.expectRevert();
        this.settleOnExternal(e1, F.HOLDER, 10 * F.CAP1);        // E1 is empty / E1 已空
        assertEq(e1.claimedOf(F.HOLDER, F.P1) + e3.claimedOf(F.HOLDER, F.P1), F.CAP1);
        assertEq(t1.balanceOf(F.HOLDER), 0);
    }

    /// The circuit changed hands (or the holder uses a second wallet): the new consumer's re-run with the old record is
    /// refused even with the old channel empty; the key's total stays within the cap. / 电路转手：新 consumer 的重跑被拒
    function test_newHolder_rerunRefused_theKeyNeverExceedsTheCap() public {
        t1.mint(F.HOLDER, F.CAP1);
        _sendAll(F.holderLongOne());
        _settleOn(e1, F.HOLDER, F.SPENT);
        assertTrue(F.NEW_HOLDER_RERUN_REFUSED);                  // funded-elsewhere: nothing for (STRANGER, P1)
        assertEq(e1.channelOf(F.STRANGER, F.P1), 0);
        assertEq(e1.sessionExpiry(F.STRANGER, F.P1, F.AGENT_KEY), 0);
        vm.expectRevert();
        this.settleOnExternal(e1, F.STRANGER, F.CAP1);
        _settleOn(e1, F.HOLDER, 10 * F.CAP1);
        assertEq(e1.claimedOf(F.HOLDER, F.P1) + e1.claimedOf(F.STRANGER, F.P1), F.CAP1);
    }

    /// Review p1m3 recheck 3 (N1, was a counterexample: the re-run on E3 without a history funded a whole cap, the key took
    /// 2 x CAP1). The kit now refuses a plan without a history: nothing for E3; the key takes the cap at most.
    /// 复核 3（N1，原为反例：不带历史在 E3 上重跑再充一整个 cap，钥匙拿到 2 × CAP1）。现在 kit 拒绝不带历史的计划：E3 上什么都不发。
    function test_escrowMoved_rerunWithoutHistoryRefused_theKeyNeverExceedsTheCap() public {
        t1.mint(F.HOLDER, 2 * F.CAP1);
        _sendAll(F.holderLongOne());
        _settleOn(e1, F.HOLDER, F.SPENT);
        assertTrue(F.MOVED_RERUN_WITHOUT_HISTORY_REFUSED);      // INVALID_ARGUMENT: no transaction for E3 / 不出 E3 的交易
        _settleOn(e1, F.HOLDER, 10 * F.CAP1);
        vm.expectRevert();
        this.settleOnExternal(e3, F.HOLDER, 10 * F.CAP1);
        assertEq(e1.claimedOf(F.HOLDER, F.P1) + e3.claimedOf(F.HOLDER, F.P1), F.CAP1);   // was 2 x CAP1
        assertEq(t1.balanceOf(F.HOLDER), F.CAP1);
    }

    /// The premise (draft §10.5), not a rule: a console that passes history [] although it kept a record is not seen; the
    /// plan funds a whole cap on E3 and the key can take 2 x CAP1. Kept to show what "keep every record" protects.
    /// 前提（§10.5），不是规则：控制台有记录却传 []，计划看不见旧通道，在 E3 上充整笔 cap，钥匙可拿 2 × CAP1。
    function test_premise_emptyHistoryWhileARecordExisted_isNotSeen() public {
        t1.mint(F.HOLDER, 2 * F.CAP1);
        _sendAll(F.holderLongOne());
        _settleOn(e1, F.HOLDER, F.SPENT);
        _sendAll(F.holderLongMovedToE3EmptyHistory());
        assertEq(e3.channelOf(F.HOLDER, F.P1), F.CAP1);
        _settleOn(e1, F.HOLDER, 10 * F.CAP1);
        _settleOn(e3, F.HOLDER, 10 * F.CAP1);
        assertEq(e1.claimedOf(F.HOLDER, F.P1) + e3.claimedOf(F.HOLDER, F.P1), 2 * F.CAP1);
    }

    /// The close-out (F1): through execute with the fee; the money returns to the container.
    function test_containerCloseOut_withdrawsThroughExecute() public {
        t1.mint(F.PRINCIPAL, 1e8);
        _sendAll(F.containerOne());
        vm.warp(F.CLOSE_AT);
        F.Tx[] memory c = F.containerOneCloseOut();
        _send(c[0]);
        vm.warp(F.CLOSE_AT + 48 hours + 7 days);   // the last second of the window / 窗口的最后一秒
        _send(c[1]);
        assertEq(e1.channelOf(F.PRINCIPAL, F.P1), 0);
        assertEq(t1.balanceOf(F.PRINCIPAL), 1e8);
    }
}
