pragma solidity ^0.8.24;

// Container agents, phase 1, milestone M4 (experimental, internal design notes, phase 1, §2.5, §2.6,
// §6.2 M4, §10.7): one spend order as the SDK carries it out (Phase1SpendFixture.sol, generated by
// scripts/gen-phase1-spend-fixture.mjs and checked by sdk/test/agent-phase1-spend.test.mjs), executed on the UNCHANGED v3
// escrow on chain 56 at the fixture's addresses: the holder's plan, the vouchers the agent key signed through the spend
// limiter (it refused the sixth: the cap is 5 prices), the close-out. Whatever order the vouchers are settled in, by
// whomever, the key's payments add up to the cap at most; a full request does not stop the key, the withdraw after it
// finds what the key left; a voucher of this escrow is nothing on another one. A test-local deployment: nothing is broadcast.
// 阶段 1 的 M4：在未改的 v3 托管上执行 SDK 完成的一单 spend：持有人计划、代理钥匙经限额器签出的凭证（第 6 张被拒，cap 为 5 个价格）、
// 收尾。不论按什么顺序、由谁结算，钥匙付出的总额不超过 cap；只是测试内部署，不广播。
import "forge-std/Test.sol";
import {TapeAPIEscrow} from "../src/TapeAPIEscrow.sol";
import {BadSignature, NothingToSettle, InsufficientBalance} from "../src/interfaces.sol";
import {Mal_ERC20, Mal_Hub} from "./mocks/MaliciousTokens.sol";
import {Phase1SpendFixture as F} from "./Phase1SpendFixture.sol";

/// @dev The 8-decimal token at the fixture's address / 部署到夹具地址的 8 位小数代币
contract Phase1SpendToken is Mal_ERC20 {
    uint8 public constant decimals = 8;
}

contract Phase1SpendTest is Test {
    TapeAPIEscrow e1;
    Phase1SpendToken token;
    address treasury = address(0x70);
    address stranger = address(0xBAD);
    uint256 constant START = 1_000e8;

    function setUp() public {
        vm.chainId(56);   // the vouchers' EIP-712 domain is chain 56 / 凭证的域是链 56
        vm.warp(F.T);
        deployCodeTo("Phase1Spend.t.sol:Phase1SpendToken", "", F.TOKEN);
        token = Phase1SpendToken(F.TOKEN);
        deployCodeTo("TapeAPIEscrow.sol:TapeAPIEscrow", abi.encode(F.TOKEN, address(new Mal_Hub()), treasury), F.E1);
        e1 = TapeAPIEscrow(F.E1);
        token.mint(F.HOLDER, START);
    }

    function _send(F.Tx memory t) internal {
        vm.prank(F.HOLDER);
        (bool ok, bytes memory ret) = t.to.call{value: t.value}(t.data);
        if (!ok) assembly { revert(add(ret, 32), mload(ret)) }
    }
    function _plan() internal {
        F.Tx[] memory p = F.plan();
        for (uint256 i = 0; i < p.length; i++) _send(p[i]);
    }
    function _settle(TapeAPIEscrow esc, F.Voucher memory v) internal {
        vm.prank(stranger);   // settle is anyone's / 任何人都能结算
        esc.settle(F.HOLDER, F.PROVIDER, v.cumulative, v.expires, v.sig);
    }

    /// FIXED P1M4-F1: the plan sets the channel to the cap and the session to expires; three of the limiter's vouchers are
    /// settled; the close-out takes back the rest: the holder paid exactly what the provider was paid for.
    function test_P1M4F1_plan_settle_closeOut() public {
        _plan();
        assertEq(e1.channelOf(F.HOLDER, F.PROVIDER), F.CAP);
        assertEq(e1.sessionExpiry(F.HOLDER, F.PROVIDER, F.AGENT_KEY), F.EXPIRES);
        assertEq(token.allowance(F.HOLDER, F.E1), 0);
        F.Voucher[] memory v = F.vouchers();
        assertEq(v.length, F.SIGNED);
        _settle(e1, v[2]);
        assertEq(e1.claimedOf(F.HOLDER, F.PROVIDER), 3 * F.PRICE);
        assertEq(token.balanceOf(F.PROVIDER), 3 * F.PRICE - (3 * F.PRICE) / 100);
        F.Tx[] memory c = F.closeOut();
        vm.warp(F.CLOSE_AT);
        _send(c[0]);   // requestWithdraw of the rest / 请求取回余下的
        vm.warp(F.CLOSE_AT + 48 hours);
        _send(c[1]);   // withdraw
        assertEq(e1.channelOf(F.HOLDER, F.PROVIDER), 0);
        assertEq(token.balanceOf(F.HOLDER), START - 3 * F.PRICE);
    }

    /// FIXED P1M4-F2: every voucher the limiter let out, settled in any order, pays the provider the cap at most: the highest
    /// is exactly the cap (claimedAtCheck 0), and nothing settles after it.
    function test_P1M4F2_everyVoucher_anyOrder_paysAtMostTheCap() public {
        _plan();
        F.Voucher[] memory v = F.vouchers();
        _settle(e1, v[3]);
        _settle(e1, v[4]);
        for (uint256 i = 0; i < v.length; i++) {
            vm.expectRevert(NothingToSettle.selector);
            _settle(e1, v[i]);
        }
        assertEq(e1.claimedOf(F.HOLDER, F.PROVIDER), F.CAP);
        assertEq(v[v.length - 1].cumulative, F.CAP);
        assertEq(e1.channelOf(F.HOLDER, F.PROVIDER), 0);
        assertEq(token.balanceOf(F.HOLDER), START - F.CAP);
    }

    /// FIXED P1M4-F3: a full requestWithdraw (the console's revoke button) does not stop the key during the cooldown (draft
    /// §2.6 row 3): the key's vouchers still settle, up to the cap and no more, and the withdraw finds nothing left.
    function test_P1M4F3_fullRequest_keyStillBoundedByTheCap() public {
        _plan();
        vm.prank(F.HOLDER);
        e1.requestWithdraw(F.PROVIDER, F.CAP);
        F.Voucher[] memory v = F.vouchers();
        _settle(e1, v[4]);
        assertEq(e1.claimedOf(F.HOLDER, F.PROVIDER), F.CAP);
        vm.warp(F.T + 48 hours);
        vm.prank(F.HOLDER);
        vm.expectRevert(InsufficientBalance.selector);
        e1.withdraw(F.PROVIDER);
    }

    /// FIXED P1M4-F5 (review p1m4): claimedAtCheck above 0. Before the plan the holder funded BASE_B by hand and settled its
    /// own voucher for it (claimedOf BASE_B, channel 0); the plan funds the cap; the limiter, started at claimedAtCheck =
    /// BASE_B, let out vouchers up to BASE_B + cap (it refused the sixth). Settled in any order, the key's vouchers pay
    /// exactly the cap since the start, and nothing settles after the highest.
    function test_P1M4F5_claimedAtCheckAboveZero_keyPaysExactlyTheCap() public {
        vm.startPrank(F.HOLDER);
        token.approve(F.E1, F.BASE_B);
        e1.fund(F.PROVIDER, F.BASE_B);
        vm.stopPrank();
        _settle(e1, F.holderOwnB());   // the holder's own voucher (signed by the consumer) / 持有人自签的凭证
        assertEq(e1.claimedOf(F.HOLDER, F.PROVIDER), F.BASE_B);
        assertEq(e1.channelOf(F.HOLDER, F.PROVIDER), 0);
        F.Tx[] memory p = F.planB();
        for (uint256 i = 0; i < p.length; i++) _send(p[i]);
        assertEq(e1.channelOf(F.HOLDER, F.PROVIDER), F.CAP);
        assertEq(e1.sessionExpiry(F.HOLDER, F.PROVIDER, F.AGENT_KEY), F.EXPIRES);
        assertEq(token.allowance(F.HOLDER, F.E1), 0);
        F.Voucher[] memory v = F.vouchersB();
        assertEq(v.length, F.SIGNED_B);
        assertEq(v[v.length - 1].cumulative, F.BASE_B + F.CAP);
        _settle(e1, v[1]);
        _settle(e1, v[v.length - 1]);
        for (uint256 i = 0; i < v.length; i++) {
            vm.expectRevert(NothingToSettle.selector);
            _settle(e1, v[i]);
        }
        assertEq(e1.claimedOf(F.HOLDER, F.PROVIDER) - F.BASE_B, F.CAP);   // the key paid exactly the cap since the start
        assertEq(e1.channelOf(F.HOLDER, F.PROVIDER), 0);
        assertEq(token.balanceOf(F.HOLDER), START - F.BASE_B - F.CAP);
    }

    /// FIXED P1RS-F1 (phase 1, restart): the vouchers signed before a restart of the agent's process and after it, with the
    /// key resumed from its sealed form by a new limiter over the same store, settle on the unchanged v3 like any others:
    /// in any order, by anyone, the key pays at most the cap, and exactly the cap with the highest.
    function test_P1RSF1_restart_vouchersEitherSide_payAtMostTheCap() public {
        _plan();
        F.Voucher[] memory a = F.vouchersR1();
        F.Voucher[] memory b = F.vouchersR2();
        assertEq(a.length, F.SIGNED_R1);
        assertEq(b.length, F.SIGNED_R2);
        _settle(e1, a[a.length - 1]);   // settled before the restart / 重启前结算
        assertEq(e1.claimedOf(F.HOLDER, F.PROVIDER), 2 * F.PRICE);
        vm.warp(F.RESTART_AT);
        _settle(e1, b[0]);
        _settle(e1, b[b.length - 1]);
        for (uint256 i = 0; i < a.length; i++) {
            vm.expectRevert(NothingToSettle.selector);
            _settle(e1, a[i]);
        }
        for (uint256 i = 0; i < b.length; i++) {
            vm.expectRevert(NothingToSettle.selector);
            _settle(e1, b[i]);
        }
        assertEq(b[b.length - 1].cumulative, F.CAP);
        assertEq(e1.claimedOf(F.HOLDER, F.PROVIDER), F.CAP);   // the key paid exactly the cap across the restart
        assertEq(e1.channelOf(F.HOLDER, F.PROVIDER), 0);
        assertEq(token.balanceOf(F.HOLDER), START - F.CAP);
        assertEq(F.SIGNED_R1 + F.SIGNED_R2, F.SIGNED);   // as many as without the restart / 与不重启时一样多
    }

    /// FIXED P1M4-F4: a voucher of this escrow is nothing on another escrow funded and authorised the same way (the
    /// verifyingContract is in its domain): the limiter's one channel is the only one the voucher can pay from.
    function test_P1M4F4_voucher_isBoundToItsEscrow() public {
        TapeAPIEscrow e2 = new TapeAPIEscrow(F.TOKEN, address(new Mal_Hub()), treasury);
        vm.startPrank(F.HOLDER);
        token.approve(address(e2), F.CAP);
        e2.fund(F.PROVIDER, F.CAP);
        e2.authorizeSession(F.PROVIDER, F.AGENT_KEY, F.EXPIRES);
        vm.stopPrank();
        F.Voucher[] memory v = F.vouchers();
        vm.expectRevert(BadSignature.selector);
        _settle(e2, v[4]);
        assertEq(e2.channelOf(F.HOLDER, F.PROVIDER), F.CAP);
    }
}
